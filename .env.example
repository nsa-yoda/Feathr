# Foundation and local Compose settings. Credentials remain optional environment overrides.
EVENT_PLATFORM_ENV=local
EVENT_PLATFORM_LOG_LEVEL=INFO
EVENT_PLATFORM_REQUEST_BODY_MAX_BYTES=1048576
EVENT_PLATFORM_REQUEST_QUERY_MAX_BYTES=8192
EVENT_PLATFORM_DEPENDENCY_TIMEOUT_SECONDS=5
COMPOSE_PROJECT_NAME=feathr
APP_PORT=8000
UI_PORT=3000
MONGO_INIT_DEADLINE_SECONDS=90
ES_JAVA_OPTS=-Xms512m -Xmx512m
# Pinned images used by docker-compose.yml: mongo:7.0.14,
# docker.elastic.co/elasticsearch/elasticsearch:8.17.3, redis:7.4.1-alpine,
# nginxinc/nginx-unprivileged:1.27-alpine, and python:3.12-slim.
# The local stack leaves Redis unauthenticated by default. Set a password only
# when also changing EVENT_PLATFORM_REDIS_URL to include it.
REDIS_PASSWORD=
EVENT_PLATFORM_MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0
EVENT_PLATFORM_MONGO_DATABASE=event_platform
EVENT_PLATFORM_MONGO_COLLECTION=events
EVENT_PLATFORM_ELASTICSEARCH_URL=http://elasticsearch:9200
EVENT_PLATFORM_ELASTICSEARCH_ALIAS=events-search
EVENT_PLATFORM_REDIS_URL=redis://redis:6379/0
EVENT_PLATFORM_CORS_ALLOWED_ORIGIN=http://localhost:3000
# Set this to the exact reviewer UI origin to enable CORS; leave unset to disable it.
# EVENT_PLATFORM_CORS_ALLOWED_ORIGIN=https://ui.example.test
# Production deployments must supply these through a secret manager; do not
# place real values in this file.
# EVENT_PLATFORM_CURSOR_SIGNING_KEY=<random-shared-key>
# EVENT_PLATFORM_PRODUCTION_API_TOKEN=<random-operator-token>
