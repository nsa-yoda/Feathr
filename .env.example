# Planning defaults only. Codex must reconcile names with typed settings.
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DATABASE=events
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_ALIAS=events-search
REDIS_URL=redis://redis:6379/0
REALTIME_CACHE_TTL_SECONDS=10
QUEUE_MAX_MESSAGES=10000
QUEUE_VISIBILITY_TIMEOUT_SECONDS=30
QUEUE_MAX_RECEIVE_COUNT=5
WORKER_CONCURRENCY=4
TRUSTED_PROXY_HOPS=0
UI_ORIGIN=http://localhost:3000
