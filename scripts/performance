#!/usr/bin/env python3
"""Small repeatable HTTP regression probe; heavy load remains a manual job."""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path
from statistics import mean
from uuid import uuid4

import httpx


def percentile(values: list[float], percentile_value: float) -> float:
    ordered = sorted(values)
    index = min(len(ordered) - 1, round((percentile_value / 100) * (len(ordered) - 1)))
    return ordered[index]


def main() -> int:
    base_url = os.environ.get("PERF_BASE_URL", "http://127.0.0.1:8000")
    requests = int(os.environ.get("PERF_REQUESTS", "20"))
    max_p95_ms = float(os.environ.get("PERF_MAX_P95_MS", "2000"))
    if requests < 1:
        print("PERF_REQUESTS must be positive", file=sys.stderr)
        return 2
    samples: dict[str, list[float]] = {
        "ingest": [],
        "events": [],
        "stats": [],
        "search": [],
        "realtime": [],
    }
    errors = 0
    suffix = uuid4().hex
    try:
        with httpx.Client(base_url=base_url, timeout=10.0) as client:
            if client.get("/health/ready").status_code != 200:
                print("performance probe: readiness failed", file=sys.stderr)
                return 1
            for index in range(requests):
                payload = {
                    "event_type": "performance.event",
                    "timestamp": "2026-01-01T00:00:00Z",
                    "user_id": f"perf-{suffix}",
                    "source_url": "https://example.invalid/performance",
                    "metadata": {"iteration": index},
                }
                started = time.perf_counter()
                response = client.post(
                    "/events", json=payload, headers={"Idempotency-Key": f"perf-{suffix}-{index}"}
                )
                samples["ingest"].append((time.perf_counter() - started) * 1000)
                if response.status_code != 202:
                    errors += 1
            for name, path in {
                "events": f"/events?user_id=perf-{suffix}&limit=50",
                "stats": "/events/stats?bucket=hour",
                "search": "/events/search?q=performance.event&limit=50",
                "realtime": "/events/stats/realtime?window_minutes=5",
            }.items():
                for _ in range(requests):
                    started = time.perf_counter()
                    response = client.get(path)
                    samples[name].append((time.perf_counter() - started) * 1000)
                    if response.status_code != 200:
                        errors += 1
    except (httpx.HTTPError, ValueError) as error:
        print(f"performance probe failed: {type(error).__name__}", file=sys.stderr)
        return 1
    result = {
        "base_url": base_url,
        "requests_per_route": requests,
        "errors": errors,
        "routes": {
            name: {
                "count": len(values),
                "mean_ms": round(mean(values), 2),
                "p50_ms": round(percentile(values, 50), 2),
                "p95_ms": round(percentile(values, 95), 2),
                "p99_ms": round(percentile(values, 99), 2),
            }
            for name, values in samples.items()
        },
    }
    output = Path(os.environ.get("PERF_OUTPUT", "artifacts/performance.json"))
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
    print(json.dumps(result, indent=2, sort_keys=True))
    p95 = max(route["p95_ms"] for route in result["routes"].values())
    return 1 if errors or p95 > max_p95_ms else 0


if __name__ == "__main__":
    raise SystemExit(main())
