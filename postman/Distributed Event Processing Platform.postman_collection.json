{
  "info": {
    "name": "Distributed Event Processing Platform",
    "_postman_id": "feathr-022-reviewer-suite",
    "description": "Reviewer acceptance suite for Feature 022. Run folders in numeric order against a healthy API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "pollDeadlineMs",
      "value": "30000"
    },
    {
      "key": "pollIntervalMs",
      "value": "250"
    },
    {
      "key": "pollRequestTimeoutMs",
      "value": "5000"
    }
