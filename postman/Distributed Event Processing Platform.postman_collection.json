    {
      "name": "01 Event Ingestion",
      "item": [
        {
          "name": "Ingest event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"{{eventType}}\",\n  \"timestamp\": \"{{eventTimestamp}}\",\n  \"user_id\": \"{{eventUserId}}\",\n  \"source_url\": \"https://example.invalid/postman\",\n  \"metadata\": {\"source\": \"postman-reviewer-suite\", \"run\": \"{{idempotencyKey}}\"}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
                  "pm.environment.set(\"eventUserId\", `postman-user-${suffix}`);",
                  "pm.environment.set(\"eventTimestamp\", new Date().toISOString());",
                  "pm.environment.set(\"idempotencyKey\", `postman-${suffix}`);",
                  "pm.environment.set(\"eventType\", \"postman.demo\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"ingestion returns 202\", () => pm.expect(pm.response.code).to.eql(202));",
                  "pm.test(\"ingestion response keys exist\", () => { pm.expect(body.event_id).to.be.a(\"string\"); pm.expect(body.request_id).to.be.a(\"string\"); pm.expect(body.status).to.eql(\"queued\"); });",
                  "pm.environment.set(\"eventId\", body.event_id);",
                  "pm.environment.set(\"requestId\", body.request_id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Idempotency Dedup",
      "item": [
        {
          "name": "Repeat same event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"{{eventType}}\",\n  \"timestamp\": \"{{eventTimestamp}}\",\n  \"user_id\": \"{{eventUserId}}\",\n  \"source_url\": \"https://example.invalid/postman\",\n  \"metadata\": {\"source\": \"postman-reviewer-suite\", \"run\": \"{{idempotencyKey}}\"}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"duplicate request remains accepted\", () => pm.expect(pm.response.code).to.eql(202));",
                  "pm.test(\"repeat response keys exist\", () => { pm.expect(body.event_id).to.be.a(\"string\"); pm.expect(body.request_id).to.be.a(\"string\"); pm.expect(body.status).to.eql(\"queued\"); });",
                  "pm.environment.set(\"duplicateEventId\", body.event_id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Event Queries",
      "item": [
        {
          "name": "Query captured event",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events?user_id={{eventUserId}}&limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const deadline = Date.now() + Number(pm.environment.get(\"pollDeadlineMs\") || 30000);",
                  "const interval = Number(pm.environment.get(\"pollIntervalMs\") || 250);",
                  "const base = pm.environment.get(\"baseUrl\");",
                  "const user = pm.environment.get(\"eventUserId\");",
                  "const expected = pm.environment.get(\"eventId\");",
                  "function poll() {",
                  "  if (Date.now() >= deadline) { pm.test(\"canonical event appears before deadline\", () => pm.expect.fail(\"query polling deadline exceeded\")); return; }",
                  "  pm.sendRequest({url: `${base}/events?user_id=${encodeURIComponent(user)}&limit=50`, method: \"GET\", timeout: Number(pm.environment.get(\"pollRequestTimeoutMs\") || 5000)}, (error, response) => {",
                  "    if (!error && response.code === 200) { const body = response.json(); const found = (body.items || []).some(item => item.event_id === expected); if (found) { pm.environment.set(\"nextCursor\", body.next_cursor || \"\"); pm.test(\"canonical query contains captured event\", () => pm.expect(found).to.eql(true)); return; } }",
                  "    setTimeout(poll, interval);",
                  "  });",
                  "}",
                  "poll();"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid cursor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events?cursor=not-a-signed-cursor"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"problem status matches HTTP status\", () => pm.expect(body.status).to.eql(pm.response.code));",
                  "pm.test(\"problem contract fields exist\", () => { pm.expect(body.detail).to.be.a(\"string\"); pm.expect(body.error_code).to.be.a(\"string\"); pm.expect(body.request_id).to.be.a(\"string\"); });",
                  "pm.test(\"invalid cursor is 422\", () => pm.expect(pm.response.code).to.eql(422));"
                ]
              }
            }
          ]
        }
      ]
    },
