    {
      "name": "05 Elasticsearch Search",
      "item": [
        {
          "name": "Search captured event",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events/search?q=postman-reviewer-suite&event_type=postman.demo&limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const deadline = Date.now() + Number(pm.environment.get(\"pollDeadlineMs\") || 30000);",
                  "const interval = Number(pm.environment.get(\"pollIntervalMs\") || 250);",
                  "const base = pm.environment.get(\"baseUrl\"); const expected = pm.environment.get(\"eventId\");",
                  "function poll() {",
                  "  if (Date.now() >= deadline) { pm.test(\"search event appears before deadline\", () => pm.expect.fail(\"search polling deadline exceeded\")); return; }",
                  "  pm.sendRequest({url: `${base}/events/search?q=postman-reviewer-suite&event_type=postman.demo&limit=50`, method: \"GET\", timeout: Number(pm.environment.get(\"pollRequestTimeoutMs\") || 5000)}, (error, response) => {",
                  "  if (!error && response.code === 503) { const body = response.json(); pm.test(\"search degraded response is a problem\", () => { pm.expect(body.status).to.eql(503); pm.expect(body.detail).to.be.a(\"string\"); pm.expect(body.error_code).to.be.a(\"string\"); pm.expect(body.request_id).to.be.a(\"string\"); }); return; }",
                  "    if (!error && response.code === 200) { const body = response.json(); const found = (body.items || []).some(item => item.event_id === expected); if (found) { pm.test(\"search contains captured event\", () => pm.expect(found).to.eql(true)); return; } }",
                  "    setTimeout(poll, interval);",
                  "  });",
                  "}",
                  "poll();"
                ]
              }
            }
          ]
        }
      ]
    },
