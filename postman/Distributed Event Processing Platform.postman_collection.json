    {
      "name": "08 Rate Limiting",
      "item": [
        {
          "name": "Rate-limit response contract",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events?limit=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"request is successful or rate limited\", () => pm.expect([200, 429]).to.include(pm.response.code));",
                  "if (pm.response.code === 429) { pm.test(\"429 has Retry-After\", () => pm.expect(Number(pm.response.headers.get(\"Retry-After\"))).to.be.greaterThan(0)); }",
                  "if (pm.response.code === 200) { pm.test(\"successful response has items\", () => pm.expect(pm.response.json().items).to.be.an(\"array\")); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admission backlog overflow contract",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events?limit=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const burst = Math.max(Number(pm.environment.get(\"rateLimitBurst\") || 180), 121);",
                  "const deadline = Date.now() + Number(pm.environment.get(\"pollDeadlineMs\") || 30000);",
                  "let count = 0; let got429 = false; let retryAfterMs = 0;",
                  "function sendNext() {",
                  "  if (Date.now() >= deadline) { pm.test(\"admission backlog overflow completes before deadline\", () => pm.expect.fail(\"admission backlog overflow deadline exceeded\")); return; }",
                  "  if (count >= burst) { setTimeout(() => pm.test(\"admission backlog overflow observes 429\", () => pm.expect(got429).to.eql(true)), retryAfterMs + 100); return; }",
                  "  pm.sendRequest({url: `${pm.environment.get(\"baseUrl\")}/events?limit=1`, method: \"GET\", timeout: Number(pm.environment.get(\"pollRequestTimeoutMs\") || 5000)}, (error, response) => {",
                  "    if (response.code === 429) { got429 = true; retryAfterMs = Math.max(retryAfterMs, Number(response.headers.get(\"Retry-After\")) * 1000); pm.expect(Number(response.headers.get(\"Retry-After\"))).to.be.greaterThan(0); }",
                  "    count += 1; sendNext();",
                  "  });",
                  "}",
                  "sendNext();"
                ]
              }
            }
          ]
        }
      ]
    },
